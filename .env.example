# Copy to .env.local and fill in. Next.js reads .env.local, never this file.
# None of these are NEXT_PUBLIC_: the screen is requested on the server.

# Supabase: Project Settings → API. Use the PUBLISHABLE key (sb_publishable_... or
# the legacy anon key), never the secret / service_role key.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Local development only (`npm run dev`): read the screen from the mock server
# instead of Supabase. Ignored in production builds, which always use Supabase.
SCREEN_SOURCE=mocks
SDUI_MOCKS_URL=http://localhost:4000
