# Copy to .env.local and fill in. Next.js reads .env.local, never this file.
# They are NEXT_PUBLIC_ because the screen is requested from the browser, so
# both values are visible to anyone: use the PUBLISHABLE key (sb_publishable_...
# or the legacy anon key), never the secret / service_role key.

# Supabase: Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
