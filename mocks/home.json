{
  "schemaVersion": "1.1.0",
  "screenId": "home",
  "theme": "default",
  "meta": { "title": "KFC Perú - Inicio", "experiment": { "id": "home_view", "variant": "guest" } },
  "actions": { "onMount": [{ "type": "TRACK_EVENT", "payload": { "name": "screen_view" } }] },
  "header": {
    "id": "guest_header",
    "type": "header_default",
    "version": 1,
    "props": {
      "logo": { "imageUrl": "https://www.kfc.com.pe/images/kfc/logo.svg", "alt": "KFC" },
      "variant": "brand",
      "buttons": [
        {
          "icon": "user",
          "label": "Mi cuenta",
          "actions": { "onPress": [{ "type": "TRACK_EVENT", "payload": { "name": "header_click", "params": { "button": "user" } } }] }
        },
        {
          "icon": "cart",
          "label": "Carrito",
          "actions": { "onPress": [{ "type": "TRACK_EVENT", "payload": { "name": "header_click", "params": { "button": "cart" } } }, { "type": "SHOW_MESSAGE", "payload": { "title": "Tu carrito está vacío", "message": "Agrega un producto del menú para empezar tu pedido." } }] }
        }
      ]
    }
  },
  "sections": [
    {
      "id": "guest_hero",
      "type": "hero_carousel",
      "version": 1,
      "props": {
        "items": [
          {
            "imageUrl": "https://delosi-pidelo.s3.amazonaws.com/kfc/banners/mobile/dipeo.webp",
            "alt": "Mega Dipeo - Combo desde S/24.90",
            "actions": { "onPress": [{ "type": "TRACK_EVENT", "payload": { "name": "hero_click", "params": { "position": 1 } } }] }
          },
          {
            "imageUrl": "https://delosi-pidelo.s3.amazonaws.com/kfc/banners/MOBILE_CYB_20260420.png",
            "alt": "Big Box - La caja que lo tiene todo",
            "actions": { "onPress": [{ "type": "TRACK_EVENT", "payload": { "name": "hero_click", "params": { "position": 2 } } }] }
          },
          {
            "imageUrl": "https://delosi-pidelo.s3.amazonaws.com/kfc/banners/BANNER_LDHW_2_MOBILE.jpg",
            "alt": "Nuevos Krushers - Refréscate",
            "actions": { "onPress": [{ "type": "TRACK_EVENT", "payload": { "name": "hero_click", "params": { "position": 3 } } }] }
          }
        ],
        "layout": "full",
        "autoplay": true
      }
    },
    {
